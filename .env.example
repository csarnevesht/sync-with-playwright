# Supabase Configuration
SUPABASE_URL=http://localhost:8000
SUPABASE_SERVICE_KEY=your-service-role-key

# Dropbox Configuration
DROPBOX_APP_KEY=your_dropbox_app_key
DROPBOX_APP_SECRET=your_dropbox_app_secret
DROPBOX_TOKEN=your_dropbox_token
# The root folder in Dropbox containing account folders
DROPBOX_FOLDER=your_dropbox_folder_path
DROPBOX_SALESFORCE_FOLDER=your_salesforce_folder_path
DROPBOX_HOLIDAY_FOLDER=your_holiday_folder_path
DROPBOX_HOLIDAY_FILE="HOLIDAY CLIENT LIST 2025.xlsx"
DATA_DIRECTORY=./data
DROPBOX_USERNAME=your_dropbox_username
DROPBOX_PASSWORD=your_dropbox_password


# Salesforce Configuration
# The URL of your Salesforce CRM instance
SALESFORCE_URL=your_salesforce_url
SALESFORCE_USERNAME=your_salesforce_username
SALESFORCE_PASSWORD=your_salesforce_password

# File Pattern Configuration
# Pattern for account information files (PDF)
ACCOUNT_INFO_PATTERN=*App.pdf

# Pattern for driver's license files (JPEG)
DRIVERS_LICENSE_PATTERN=*DL.jpeg

# Upload Configuration
# Maximum time to wait for file upload in seconds (default: 300)
UPLOAD_TIMEOUT=300

# Browser Configuration
# Chrome debugging port (default: 9222)
CHROME_DEBUG_PORT=9222

# Logging Configuration
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Debug Configuration
# Enable debug mode with interactive prompts (true/false)
DEBUG_MODE=false

# Test Configuration
# Enable test mode to use mock data instead of Dropbox (true/false)
TEST_MODE=false

# Temporary Directory Configuration
# Base directory for temporary files (default: system temp)
TEMP_DIR=/tmp/sync-files

# Retry Configuration
# Number of retries for failed uploads (default: 3)
MAX_RETRIES=3

# Batch Processing Configuration
# Maximum number of files to upload in a single batch (default: 10)
MAX_BATCH_SIZE=10 


